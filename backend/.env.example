PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL (default cocok dengan docker-compose.yml di root)
# Untuk Supabase, ganti dengan connection string Supabase Anda.
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5433/login_form_db
DIRECT_URL=postgresql://postgres:postgres_dev_password@localhost:5433/login_form_db

# JWT Secrets (minimal 32 karakter acak, gunakan secret yang berbeda untuk access & refresh)
JWT_ACCESS_SECRET=replace-with-a-strong-random-access-secret-minimum-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-min-32-chars

# Masa berlaku token
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
